# ==============================================================================
# Agentic RAG Notebook - Environment Configuration
# ==============================================================================

# --- Active Client Selection ---
# Choose which LLM client to use by default: "groq" or "openai_local"
LLM_PROVIDER=groq

# Choose orchestration engine: "langchain" (Phase 1 default) or "langgraph" (Phase 2)
ORCHESTRATION_ENGINE=langchain

# --- Groq Configuration (https://console.groq.com) ---
GROQ_API_KEY=API_KEY
GROQ_MODEL=llama-3.3-70b-versatile
# Alternative Qwen on Groq: qwen/qwen3-32b

# --- Local OpenAI-Compatible Server (Qwen via vLLM / Ollama / LM Studio / LiteLLM) ---
OPENAI_LOCAL_BASE_URL=http://localhost:8000/v1
OPENAI_LOCAL_API_KEY=your_local_server_api_key
OPENAI_LOCAL_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# --- Embedding Provider Configuration ---
# Note: Groq does NOT offer an /embeddings endpoint.
# Options: "huggingface" (default local zero-key), "openai", or "openai_local"
EMBEDDING_PROVIDER=huggingface
HUGGINGFACE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
HUGGINGFACE_EMBEDDING_DEVICE=cpu

# Used when EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Used when EMBEDDING_PROVIDER=openai_local (custom URL + API key)
OPENAI_LOCAL_EMBEDDING_BASE_URL=http://localhost:8001/v1
OPENAI_LOCAL_EMBEDDING_API_KEY=your_local_embedding_key
OPENAI_LOCAL_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# --- Storage & Persistence ---
DATA_DIR=./data
CHROMA_PERSIST_DIR=./data/chroma_db
SQLITE_DB_PATH=./data/sessions.db
UPLOAD_DIR=./data/uploads

# --- Logging Configuration ---
LOG_DIR=./logs
LOG_FILE_NAME=app.log
LOG_LEVEL=INFO
LOG_BACKUP_COUNT=30

# --- Docling Ingestion ---
DOCLING_DEFAULT_OCR=false
DOCLING_MAX_CHUNK_TOKENS=512
RAG_TOP_K=4

# --- Mandatory Guardrail Middleware ---
ENABLE_INPUT_GUARDRAILS=true
ENABLE_OUTPUT_GUARDRAILS=true
PII_REDACTION_ENABLED=true
MAX_INPUT_CHARS=4000
MAX_HISTORY_TURNS=12
STRICT_GROUNDING_MODE=false
